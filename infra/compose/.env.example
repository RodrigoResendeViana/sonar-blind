# Copie para .env para rodar na sua máquina. O .env nunca entra no Git.
# Em produção, o deploy.sh gera o .env com os valores do AWS Parameter Store.

SONAR_SITE_ADDRESS=http://localhost
SONAR_DB_PASSWORD=troque-para-uma-senha-local
SONAR_SAL_HASH=troque-para-um-texto-aleatorio
SONAR_MQTT_CONF=mosquitto.local.conf

# opcionais
SONAR_OLHOVIVO_TOKEN=
SONAR_TOKEN_SERVICO=
# IA generativa: COMPOSE_PROFILES=ia e SONAR_IA_URL=http://ia:8100 (precisa de ~4 GB livres)
SONAR_IA_URL=
SONAR_IA_MODELO=qwen2.5:3b
# perfis: ia (Ollama + agente), rpa (n8n em http://localhost:5678); ex.: COMPOSE_PROFILES=ia,rpa
COMPOSE_PROFILES=
# com o perfil rpa, a API avisa o n8n na hora em que o passageiro aceita registrar a reclamação
SONAR_RPA_WEBHOOK_URL=
SONAR_N8N_CHAVE=troque-para-um-texto-aleatorio
